<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign public_documents = site.pages | concat: site.posts | concat: site.projects %}
  {% assign sitemap_paths = "/|/can-i-build/|/can-i-build/site-feasibility/|/can-i-build/size-and-layout/|/can-i-build/cost-and-budget/|/can-i-build/process-and-timeline/|/projects/|/projects/146dowding/|/projects/brisbane-granny-flat-project/|/about/|/contact/" | split: "|" %}
  {% for path in sitemap_paths %}
    {% assign document = public_documents | where: "url", path | first %}
  <url>
    <loc>{{ path | prepend: site.url }}</loc>
    {% if document.last_modified_at %}<lastmod>{{ document.last_modified_at | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endfor %}
</urlset>
